		"@types/cookie": "^0.5.4",
		"autoprefixer": "^10.4.19",
		"eslint": "^8.57.0",
		"eslint-config-prettier": "^8.10.0",
		"eslint-plugin-svelte": "^2.38.0",
		"postcss": "^8.4.38",
		"prettier": "^2.8.8",
		"prettier-plugin-svelte": "^2.10.1",
		"svelte": "^4.2.15",
		"svelte-check": "^3.7.0",
		"tailwindcss": "^3.4.3",
