		"@sveltejs/kit": "^1.25.1",
		"@tailwindcss/typography": "^0.5.10",
		"@types/cookie": "^0.5.1",
		"autoprefixer": "^10.4.16",
		"daisyui": "^3.9.2",
		"eslint": "^8.41.0",
		"eslint-config-prettier": "^8.8.0",
		"eslint-plugin-svelte": "^2.34.0",
		"postcss": "^8.4.31",
		"prettier": "^2.8.8",
		"prettier-plugin-svelte": "^2.10.1",
		"svelte": "^4.2.1",
		"svelte-check": "^3.5.2",
		"tailwindcss": "^3.3.3",
